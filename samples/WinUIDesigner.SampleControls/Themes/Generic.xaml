<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIDesigner.SampleControls">

    <Style TargetType="local:SampleCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SampleCard">
                    <Border Background="SteelBlue" CornerRadius="4" Padding="12">
                        <TextBlock Text="{TemplateBinding Title}" Foreground="White" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
