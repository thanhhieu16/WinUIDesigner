<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A control library for adding to the shell's toolbox at runtime (File > Add Controls
    Assembly...). Nothing references it: the walkthrough copies its build output and loads it
    the way a user would. Toolbox-assemblies spec Decision 8.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WinUIDesigner.SampleControls</RootNamespace>
    <Nullable>disable</Nullable>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
  </ItemGroup>

</Project>
