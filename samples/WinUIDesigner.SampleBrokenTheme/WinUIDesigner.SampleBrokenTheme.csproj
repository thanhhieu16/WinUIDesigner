<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A control library whose theme is well-formed XML but cannot load: its Generic.xaml merges a
    dictionary from ms-appx:///, which a library added at runtime cannot resolve. The
    walkthrough adds it last, to measure whether the app survives XamlReader.Load failing on a
    theme the shell's well-formed check lets through. Library-resources plan, Results.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WinUIDesigner.SampleBrokenTheme</RootNamespace>
    <Nullable>disable</Nullable>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
  </ItemGroup>

</Project>
